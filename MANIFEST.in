include README.md THIRD_PARTY_NOTICES.md environment.yml
recursive-include licenses *.txt
recursive-include src/fnit/_vendor_fsl * .*
recursive-include docs *.md *.json *.png
recursive-include tools *.py *.md
recursive-include tests *.py *.json
recursive-include validation/recon_all *.py *.md *.json *.cu
recursive-include validation/fast_vbm README.md SHA256SUMS *.public.json *.public.csv *.py
recursive-include validation/applywarp README.md SHA256SUMS *.json
recursive-include validation/flirt README.md SHA256SUMS *.public.json
recursive-include validation/synthseg README.md SHA256SUMS *.public.json
recursive-include validation/topup *.public.json
exclude validation/fast_vbm/release.v0.9.public.json

# Runtime checkpoints, MRI templates, and generated images are external data.
global-exclude *.pt *.pth *.h5 *.hdf5 *.ckpt
global-exclude *.pyc *.pyo
global-exclude *.nii *.nii.gz *.mgz *.mgh
prune weights
prune work
