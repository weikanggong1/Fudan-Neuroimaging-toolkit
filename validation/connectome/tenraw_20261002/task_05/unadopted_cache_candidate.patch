+class FNIRTInverseCache:
+    """调用范围内复用一个 FNIRT 逆场；不写磁盘，不跨运行跳过步骤。
+
+    key 包括系数体素内容、header/affine、目标 header/affine/shape 和设备。
+    目标强度不参与求逆，因此不计入 key。只保留最近一个结果；失败不入缓存。
+    实例应在一次受试者 atlas 构建前创建，结束后丢弃；不用于线程共享。
+    """
+
+    def __init__(self):
+        self._key = None
+        self._inverse = None
+
+    def clear(self):
+        """释放当前 CPU 逆场引用。"""
+        self._key = self._inverse = None
+
+    def get(self, coefficients, reference, *, device):
+        digest = hashlib.sha256()
+        for image in (coefficients, reference):
+            digest.update(type(image.header).__name__.encode())
+            digest.update(image.header.binaryblock)
+            digest.update(np.asarray(image.affine, dtype=np.float64).tobytes())
+            digest.update(str(image.shape).encode())
+            for extension in getattr(image.header, "extensions", ()):
+                digest.update(str(extension.get_code()).encode())
+                digest.update(extension.content)
+        data = np.ascontiguousarray(np.asanyarray(coefficients.dataobj))
+        digest.update(data.dtype.str.encode())
+        digest.update(memoryview(data).cast("B"))
+        digest.update(str(torch.device(device)).encode())
+        key = digest.digest()
+        if key != self._key:
+            inverse = invert_fnirt_t1_warp(coefficients, reference, device=device)
+            # Publish only after successful inversion; preserve the previous entry on failure.
+            self._key, self._inverse = key, inverse
+        # Caller-owned copy prevents accidental mutation from poisoning the cache.
+        return nib.Nifti1Image(np.array(self._inverse.dataobj, copy=True),
+                               self._inverse.affine.copy(), self._inverse.header.copy())
+
+
