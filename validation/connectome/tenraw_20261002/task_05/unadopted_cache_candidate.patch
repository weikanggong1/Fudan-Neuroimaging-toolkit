@@ -0,0 +1,76 @@
+"""Invalidation, partial failures and unchanged endpoint geometry semantics."""
+from pathlib import Path
+
+import nibabel as nib
+import numpy as np
+import pytest
+import torch
+
+import fnit.connectome.atlas_tian as tian
+from fnit.connectome.assignment import EndpointSearchGeometry, build_connectomes
+
+
+def test_inverse_content_grid_invalidation_and_caller_mutation(monkeypatch):
+    calls = []
+    def invert(coefficients, reference, *, device):
+        calls.append(device)
+        return nib.Nifti1Image(np.ones((*reference.shape, 3), np.float32), reference.affine)
+    monkeypatch.setattr(tian, "invert_fnirt_t1_warp", invert)
+    coefficients = nib.Nifti1Image(np.zeros((2, 2, 2, 3), np.float32), np.eye(4))
+    reference = nib.Nifti1Image(np.zeros((3, 3, 3)), np.eye(4))
+    cache = tian.FNIRTInverseCache()
+    first = cache.get(coefficients, reference, device="cpu")
+    np.asarray(first.dataobj)[:] = 99
+    assert np.all(np.asarray(cache.get(coefficients, reference, device="cpu").dataobj) == 1)
+    assert len(calls) == 1
+    # Reference intensities do not affect the inverse; geometry and coefficients do.
+    np.asarray(reference.dataobj)[:] = 42
+    cache.get(coefficients, reference, device="cpu")
+    assert len(calls) == 1
+    np.asarray(coefficients.dataobj)[0, 0, 0, 0] = 1
+    cache.get(coefficients, reference, device="cpu")
+    assert len(calls) == 2
+    changed = nib.Nifti1Image(np.zeros(reference.shape), np.diag([2., 1., 1., 1.]))
+    cache.get(coefficients, changed, device="cpu")
+    assert len(calls) == 3
+    cache.clear()
+    cache.get(coefficients, changed, device="cpu")
+    assert len(calls) == 4
+
+
+def test_failed_inverse_not_cached(monkeypatch):
+    def fail(*args, **kwargs):
+        raise RuntimeError("incomplete")
+    monkeypatch.setattr(tian, "invert_fnirt_t1_warp", fail)
+    image = nib.Nifti1Image(np.zeros((2, 2, 2)), np.eye(4))
+    cache = tian.FNIRTInverseCache()
+    with pytest.raises(RuntimeError):
+        cache.get(image, image, device="cpu")
+    assert cache._key is None
+
+
+@pytest.mark.parametrize("device", ["cpu", "cuda"] if torch.cuda.is_available() else ["cpu"])
+def test_cached_search_preserves_ties_shear_strict_radius_and_metrics(device):
+    affine = torch.tensor([[1., .3, 0., 10.], [0., 2., .2, 20.],
+                           [0., 0., 1., 30.], [0., 0., 0., 1.]], device=device)
+    voxels = torch.tensor([[[1., 1., 1.], [3., 1., 1.]],
+                           [[2., 1., 1.], [3., 1., 1.]],
+                           [[-10., 1., 1.], [3., 1., 1.]]], device=device)
+    endpoints = voxels @ affine[:3, :3].T + affine[:3, 3]
+    atlas = torch.zeros((5, 3, 3), dtype=torch.int32, device=device)
+    atlas[1, 1, 1], atlas[3, 1, 1] = 1, 3
+    geometry = EndpointSearchGeometry(affine, radius=1., device=device)
+    kwargs = dict(weights=torch.tensor([.1, 2., 3.], device=device),
+                  lengths=torch.tensor([1., 2., 3.], device=device),
+                  fa=torch.tensor([.1, .2, .3], device=device), radius=1., batch_size=2)
+    for labels in (atlas, atlas.flip(0)):
+        expected = build_connectomes(endpoints, labels, affine, **kwargs)
+        actual = build_connectomes(endpoints, labels, affine, search_geometry=geometry, **kwargs)
+        for name in expected:
+            assert torch.equal(expected[name], actual[name])
+    with pytest.raises(ValueError, match="search_geometry"):
+        build_connectomes(endpoints, atlas, affine, radius=2., search_geometry=geometry)
+    changed = affine.clone(); changed[0, 3] += 1
+    with pytest.raises(ValueError, match="search_geometry"):
+        build_connectomes(endpoints, atlas, changed, radius=1., search_geometry=geometry)
+
