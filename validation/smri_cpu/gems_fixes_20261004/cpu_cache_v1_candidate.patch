+class _CPUEMImageCache:
+    """One fit's fixed EM data; arithmetic and responsibility ordering stay intact.
+
+    Tensor version counters invalidate changes made through aliases. Calls with
+    gradients, CPU autocast, inference tensors or CUDA retain the uncached path.
+    No image or geometry is cached across public TorchGEMS calls.
+    """
+
+    def __init__(self):
+        self._image = None
+        self._key = None
+        self._prepared = None
+
+    def prepare(self, image: torch.Tensor, dtype: torch.dtype):
+        if (image.device.type != "cpu" or image.requires_grad
+                or torch.is_autocast_enabled("cpu")):
+            return None
+        try:
+            version = image._version
+        except RuntimeError:
+            return None
+        key = (version, tuple(image.shape), tuple(image.stride()),
+               image.storage_offset(), image.dtype, dtype)
+        if image is not self._image or key != self._key:
+            data = _as_modalities(image).to(dtype=dtype)
+            modalities = data.shape[0]
+            flat_x = data.reshape(modalities, -1).T
+            finite = torch.isfinite(flat_x).all(1)
+            nonzero = flat_x.abs().sum(1) > 0
+            keep = finite & nonzero
+            self._prepared = (flat_x[keep], keep, modalities)
+            self._image, self._key = image, key
+        return self._prepared
+
+
