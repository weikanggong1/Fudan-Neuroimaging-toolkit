+def _cropped_cubic_image(data: np.ndarray, step: np.ndarray,
+                         origin: np.ndarray, shape: tuple[int, ...]) -> np.ndarray:
+    """Cubic B-splines in the cropped image's domain, preserving source sign.
+
+    Each coefficient axis is stored as FP32, with whole-sample mirror edges.
+    Outside queries use the rounded-voxel support rule. Positive source images
+    cannot acquire negative intensity from spline ringing.
+    """
+    coefficients = np.asarray(data, dtype=np.float32)
+    for axis in range(3):
+        coefficients = ndimage.spline_filter1d(
+            coefficients, order=3, axis=axis, output=np.float32, mode="mirror")
+    sampled = ndimage.affine_transform(
+        coefficients, np.diag(step), offset=origin, output_shape=shape,
+        order=3, mode="mirror", prefilter=False).astype(np.float32)
+    if not np.any(data < 0):
+        np.maximum(sampled, 0, out=sampled)
+    for axis in range(3):
+        rounded = np.rint(origin[axis] + np.arange(shape[axis]) * step[axis])
+        outside = (rounded < 0) | (rounded >= data.shape[axis])
+        selector = [slice(None)] * 3
+        selector[axis] = outside
+        sampled[tuple(selector)] = 0
+    return sampled
+
+
+
+def _sample_working_mask(data: np.ndarray, source, target, order: int) -> np.ndarray:
+    """Recipe-only FP32 coordinates and nearest half-up rounding.
+
+    This validation candidate changes preparation masks only. Shared image
+    resampling and evaluation grids retain their existing definitions.
+    """
+    transform = np.linalg.inv(source.affine) @ target.affine
+    matrix, offset = transform[:3, :3], transform[:3, 3]
+    if np.max(np.abs(matrix - np.diag(np.diag(matrix)))) > 1e-8:
+        raise ValueError('working masks require parallel source/target axes')
+    axes = [np.float32(offset[d]) + np.arange(target.shape[d], dtype=np.float32)
+            * np.float32(matrix[d, d]) for d in range(3)]
+    valid = np.ones(target.shape, bool)
+    for dimension, axis in enumerate(axes):
+        rounded = np.rint(axis)
+        support = (rounded >= 0) & (rounded < data.shape[dimension])
+        shape = [1, 1, 1]
+        shape[dimension] = len(axis)
+        valid &= support.reshape(shape)
+    if order == 0:
+        indices = [np.clip(np.floor(axis + .5).astype(np.int64), 0, data.shape[d] - 1)
+                   for d, axis in enumerate(axes)]
+        sampled = np.asarray(data[np.ix_(*indices)], np.float32)
+    elif order == 1:
+        coordinates = np.stack(np.broadcast_arrays(axes[0][:, None, None],
+                                                   axes[1][None, :, None], axes[2][None, None, :]))
+        sampled = ndimage.map_coordinates(np.asarray(data, np.float32), coordinates,
+                                          order=1, mode='nearest', prefilter=False)
+    else:
+        raise ValueError('working mask interpolation must be nearest or linear')
+    sampled[~valid] = 0
+    return sampled
+
+
 def _native(volume: np.ndarray, affine: np.ndarray, target, order: int) -> np.ndarray:
     source = nib.Nifti1Image(volume, affine)
     return np.asarray(resample_from_to(source, (target.shape, target.affine), order=order).dataobj)
