+def _compact_mesh_data_cost(priors, likelihood, *, double_accumulation=False):
+    """Mesh likelihood; CPU follows KVL's epsilon after the class sum.
+
+    EM posterior normalization has its own definition and is unchanged. CUDA
+    retains the established logsumexp expression until an official regression.
+    """
+    joint = priors.clamp_min(torch.finfo(priors.dtype).tiny).log() + likelihood
+    log_density = joint.logsumexp(dim=0)
+    if priors.device.type == "cpu":
+        log_density = torch.logaddexp(log_density, log_density.new_tensor(math.log(1e-15)))
+    return -log_density.sum(dtype=torch.float64 if double_accumulation else joint.dtype)
+
