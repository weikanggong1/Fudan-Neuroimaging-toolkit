+for case in c['cases']:
+ mri=Path(case['official'])/'mri';item={'id':case['id'],'input_sha256':{n:sha(mri/n) for n in ('nu.mgz','brainmask.mgz','transforms/talairach.lta')},'runs':[]};report['cases'].append(item);save()
