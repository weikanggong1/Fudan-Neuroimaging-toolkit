+def save_synthstrip_mgh(source_file: str | Path, stripped_image,
+                        output_file: str | Path) -> None:
+    """将SynthStrip结果写成源conform网格和dtype的3D MGH/MGZ。
+
+    source_file为conform MGH/MGZ；stripped_image为同网格nibabel图像；
